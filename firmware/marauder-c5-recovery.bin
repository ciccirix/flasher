var map=L.map('m').setView([42.35,14.17],14);
L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:19,attribution:'OSM'}).addTo(map);
var me=L.circleMarker([42.35,14.17],{radius:7,color:'#1976d2',fillColor:'#1976d2',fillOpacity:.7}).addTo(map);
var aps=L.layerGroup().addTo(map); var centered=false;
function encColor(e){return e=='O'?'#2e7d32':e=='W'?'#d32f2f':e=='E'?'#f57c00':'#777';}
function encName(e){return e=='O'?'OPEN':e=='W'?'WPA':e=='E'?'WEP':'?';}
async function tick(){
 try{let g=await (await fetch('/api/gps')).json();
  document.getElementById('i').textContent=(g.fix?'':'NO FIX ')+'sat:'+g.sats+' '+g.lat.toFixed(5)+','+g.lon.toFixed(5)+' ('+g.n+' reti)';
  if(g.fix){me.setLatLng([g.lat,g.lon]); if(!centered){map.setView([g.lat,g.lon],16);centered=true;}}
 }catch(e){}
 try{let a=await (await fetch('/api/aps')).json(); aps.clearLayers();
  a.forEach(p=>{var col=encColor(p.e);L.circleMarker([p.lat,p.lon],{radius:5,color:col,fillColor:col,fillOpacity:.8}).bindPopup(p.s+'<br>'+encName(p.e)+' '+p.r+'dBm').addTo(aps);});
 }catch(e){}
}
setInterval(tick,3000); tick();
</script></body></html>␀␀␀<!doctype html><html><head>
<meta name=viewport content="width=device-width,initial-scale=1"><title>Marauder SD</title>
<style>body{font-family:sans-serif;background:#0f1115;color:#e8e8e8;padding:16px}
h2{color:#39c6ff;letter-spacing:2px;text-align:center}
table{width:100%;border-collapse:collapse}td{padding:6px;border-bottom:1px solid #223}
a{color:#8fd}button{background:#c0282a;color:#fff;border:0;border-radius:6px;padding:6px 10px}
.up{background:#2a7fc0}form{margin:12px 0;text-align:center}</style></head><body>
<h2>MARAUDER&nbsp;SD</h2>
<form method=POST action=/up enctype=multipart/form-data>
<input type=file name=f required> <button class=up type=submit>Carica</button></form>
<table id=t><tr><td>caricamento...</td></tr></table>
<script>
async function load(){let r=await(await fetch('/list')).json();let h='';
if(!r.length)h='<tr><td>(nessun file / SD non montata)</td></tr>';
r.forEach(f=>{h+=`<tr><td><a href="/dl?f=${encodeURIComponent(f.n)}">${f.n}</a></td>
<td>${f.s}B</td><td><button onclick="rm('${f.n}')">X</button></td></tr>`;});
document.getElementById('t').innerHTML=h;}
async function rm(n){if(!confirm('Cancellare '+n+'?'))return;
await fetch('/rm?f='+encodeURIComponent(n));load();}
load();
</script></body></html>␀␀␀␀␀␀␀␀␀␀␀␀жќBћBРсB0ЪBмЪBNЫBиЫBJШBnЧBДЦB€ЦB”ќBF	B␀␀␀␀␀␀␀␀vтBzчB’dBЬB”dB␀␀␀␀␀␀␀␀6BnBФсBЂ¶BјBHBP¶B‚µB¦ґBѕҐBjґBдB`B␀␀␀␀␀␀␀␀ІшBишBlтBrАB
